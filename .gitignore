# Godot 4 產生的匯入快取與暫存
.godot/
/android/
*.tmp
*.translation

# 匯出設定含本機路徑與金鑰，不進版控
export_presets.cfg

# AI 生成的原始美術素材不進 git（見規格 8.2）
# 以本地 + 雲端硬碟備份，只有裁切壓縮後的成品進 game/assets/
art_src/

# subagent-driven-development 的進度暫存
.superpowers/

# GdUnit4 產生的測試報告
reports/

# Python 快取
__pycache__/

# 並行開發用的 git worktree（美術軌與程式軌各占一個工作目錄）
.worktrees/

# 決議不進版控：20MB，Regular/Bold 兩個字重已夠用，避免無謂占用 LFS 額度
game/assets/fonts/TaipeiSansTCBeta-Light.ttf
game/assets/fonts/TaipeiSansTCBeta-Light.ttf.import
