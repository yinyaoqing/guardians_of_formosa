{
  "_doc": "A1 單位生成（完整版）：SDXL Base + IP-Adapter 史料參考圖 + ControlNet openpose 骨架。這是 A1 分析的結論組合——ControlNet 管構圖與姿勢（實測有效，消滅了設定表崩壞），IP-Adapter 管服飾內容（模型缺乏 17 世紀明鄭／西拉雅／VOC 的知識，只能餵圖）。",

  "_usage": [
    "節點 12 = 骨架圖（art/scripts/make_poses.py 產出，已同步到 comfyui/input/）",
    "節點 9  = 史料參考圖（art/scripts/fetch_refs.py 下載後複製到 comfyui/input/）",
    "IP-Adapter 會同時搬走參考圖的風格與內容。史料圖是油畫或銅版畫，若 weight 太高會把畫風一起帶進來，",
    "與『簡單卡通化』相衝。故 weight 壓在 0.6、end_at 0.6——只讓它在前段決定服飾結構，後段交回 prompt 收style。"
  ],

  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" }
  },
  "2": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "sdxl_vae_fp16_fix.safetensors" }
  },
  "9": {
    "class_type": "LoadImage",
    "inputs": { "image": "ref_ming.jpg", "upload": "image" }
  },
  "12": {
    "class_type": "LoadImage",
    "inputs": { "image": "pose_musket_ready.png", "upload": "image" }
  },
  "20": {
    "class_type": "IPAdapterUnifiedLoader",
    "inputs": { "model": ["1", 0], "preset": "PLUS (high strength)" }
  },
  "21": {
    "class_type": "IPAdapterAdvanced",
    "inputs": {
      "model": ["20", 0],
      "ipadapter": ["20", 1],
      "image": ["9", 0],
      "weight": 0.6,
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 0.6,
      "embeds_scaling": "V only"
    }
  },
  "11": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "controlnet-union-sdxl-1.0-promax.safetensors" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["1", 1], "text": "placeholder positive" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["1", 1], "text": "placeholder negative" }
  },
  "13": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["3", 0],
      "negative": ["4", 0],
      "control_net": ["11", 0],
      "image": ["12", 0],
      "strength": 0.85,
      "start_percent": 0.0,
      "end_percent": 0.75
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 768, "height": 1024, "batch_size": 2 }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["21", 0],
      "positive": ["13", 0],
      "negative": ["13", 1],
      "latent_image": ["5", 0],
      "seed": 16610430,
      "steps": 28,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["6", 0], "vae": ["2", 0] }
  },
  "8": {
    "class_type": "SaveImage",
    "inputs": { "images": ["7", 0], "filename_prefix": "a1_ref_pose" }
  }
}
